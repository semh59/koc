#!/bin/sh
# Commit gate: fast checks only; the full suite is `npm test`. Enable once per clone: git config core.hooksPath .githooks
node scripts/dead-code.test.js || { echo "Commit blocked: dead code under www/ (see FAIL line above)."; exit 1; }
for f in $(git diff --cached --name-only --diff-filter=ACM -- 'www/*.js' 'scripts/*.js'); do
  node --check "$f" || { echo "Commit blocked: syntax error in $f"; exit 1; }
done

            android:action="android.intent.action.VIEW"
            android:targetClass="com.neowell.app.MainActivity"
            android:targetPackage="com.neowell.app">
            <extra
                android:name="nw_go"
                android:value="food" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="nw_weight"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/nw_sc_weight"

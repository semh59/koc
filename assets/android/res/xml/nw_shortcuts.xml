        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.neowell.app.MainActivity"
            android:targetPackage="com.neowell.app">
            <extra
                android:name="nw_go"
                android:value="weight" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="nw_exercise"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/nw_sc_exercise"
        android:shortcutLongLabel="@string/nw_sc_exercise_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.neowell.app.MainActivity"
            android:targetPackage="com.neowell.app">
            <extra
                android:name="nw_go"
                android:value="exercise" />
        </intent>
    </shortcut>
</shortcuts>
